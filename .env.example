# Database — pick ONE, or omit all to fall back to local SQLite (pinktt.db) for dev.
# Checked in this order: DATABASE_URL > TURSO_DATABASE_URL > local SQLite.

# Option A: Postgres (e.g. Supabase). Get this from Supabase dashboard ->
# Project Settings -> Database -> Connection string (URI, "Session pooler" or
# direct connection both work) with your DB password filled in.
DATABASE_URL=postgres://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Option B: Turso (libSQL)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# Server
PORT=3000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-string

# ID verification (POST /api/verify-id) — omit to run in DEMO MODE (auto-approves, logs a warning)
ANTHROPIC_API_KEY=

# Set to "true" to show the demo-account quick-fill panel on the login screen.
# Defaults to visible outside production and hidden when NODE_ENV=production.
SHOW_DEMO_ACCOUNTS=false
